@model Valoriza.API.Models.TrilhaTreinamento
@{
    ViewData["Title"] = "Editar Trilha";
}

<div class="mb-3">
    <a asp-action="Details" asp-route-id="@Model.Id"
       class="btn btn-sm btn-outline-secondary">&larr; Voltar</a>
</div>

<div class="card p-4 col-md-8">
    <h3 class="h5 mb-3">Editar trilha</h3>

    <form method="post" asp-action="Edit">
        <input type="hidden" name="id" value="@Model.Id" />

        <div class="mb-3">
            <label class="form-label">Título</label>
            <input type="text" name="titulo" class="form-control" value="@Model.Titulo" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Descrição</label>
            <textarea name="descricao" class="form-control" rows="3">@Model.Descricao</textarea>
        </div>
        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">Carga horária (min)</label>
                <input type="number" name="cargaHoraria" class="form-control"
                       value="@Model.CargaHoraria" min="1" />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Nível</label>
                <select name="nivel" class="form-select">
                    <option>Básico</option>
                    <option>Intermediário</option>
                    <option>Avançado</option>
                </select>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Ativa</label>
                <select name="ativa" class="form-select">
                    <option value="true">Sim</option>
                    <option value="false">Não</option>
                </select>
            </div>
        </div>
        <button type="submit" class="btn btn-dark">Salvar</button>
    </form>
</div>