<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Valoriza</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body { background: #f5f6fa; }
        .navbar-brand { font-weight: 700; }
        .card { border: none; box-shadow: 0 2px 8px rgba(0,0,0,.06); }
    </style>
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">Valoriza</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="nav">
            <ul class="navbar-nav me-auto">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Treinamentos" asp-action="Index">Treinamentos</a>
                    </li>

                    @* Gestor e Admin veem Denúncias e Indicadores *@
                    @if (User.IsInRole("AdminValoriza") || User.IsInRole("AdminEmpresa") || User.IsInRole("GestorDEI"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Denuncias" asp-action="Index">Denúncias</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Indicadores" asp-action="Index">Indicadores</a>
                        </li>
                    }

                    @* Só Admin vê Usuários *@
                    @if (User.IsInRole("AdminValoriza") || User.IsInRole("AdminEmpresa"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Usuarios" asp-action="Index">Usuários</a>
                        </li>
                    }
                }
            </ul>

            <ul class="navbar-nav">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item">
                        <span class="nav-link text-white-50">@User.Identity.Name</span>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Account" asp-action="Logout">Sair</a>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>

<main class="container pb-5">
    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success">@TempData["Sucesso"]</div>
    }
    @RenderBody()
</main>

<footer class="text-center text-muted py-3">
    <small>Valoriza &copy; 2026 — Diversidade, Equidade e Inclusão</small>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@RenderSection("Scripts", required: false)
</body>
</html>