@model List<Valoriza.API.Models.TrilhaTreinamento>
@{
    ViewData["Title"] = "Treinamentos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 mb-0">Trilhas de Treinamento</h2>
    <a asp-action="Create" class="btn btn-dark btn-sm">Nova trilha</a>
</div>

<div class="row g-3">
@if (Model == null || !Model.Any())
{
    <div class="col-12">
        <div class="alert alert-light border">Nenhuma trilha cadastrada.</div>
    </div>
}
else
{
    foreach (var t in Model)
    {
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">@t.Titulo</h5>
                    <p class="card-text text-muted small">@t.Descricao</p>
                    <div class="d-flex gap-2">
                        <span class="badge bg-secondary">@t.Nivel</span>
                        <span class="badge bg-light text-dark">@t.CargaHoraria min</span>
                        <span class="badge bg-light text-dark">@(t.Conteudos?.Count ?? 0) conteúdos</span>
                    </div>
                </div>
            </div>
        </div>
    }
}
</div>
