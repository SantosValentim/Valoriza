@model List<Valoriza.API.Models.TrilhaTreinamento>
@{
    ViewData["Title"] = "Treinamentos";
    // true se AdminValoriza ou AdminEmpresa (vem do Controller)
    var isAdmin = (bool)(ViewBag.IsAdmin ?? false);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 mb-0">Trilhas de Treinamento</h2>

    @* Botão "Nova trilha" só para Admin *@
    @if (isAdmin)
    {
        <a asp-action="Create" class="btn btn-dark btn-sm">Nova trilha</a>
    }
</div>

<div class="row g-3">
@if (Model == null || !Model.Any())
{
    <div class="col-12">
        <div class="alert alert-light border">Nenhuma trilha cadastrada.</div>
    </div>
}
else
{
    foreach (var t in Model)
    {
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between">
                        <h5 class="card-title">@t.Titulo</h5>
                        @if (!t.Ativa)
                        {
                            <span class="badge bg-danger">Inativa</span>
                        }
                    </div>

                    <p class="card-text text-muted small flex-grow-1">@t.Descricao</p>

                    <div class="d-flex gap-2 mb-3 flex-wrap">
                        <span class="badge bg-secondary">@t.Nivel</span>
                        <span class="badge bg-light text-dark">@t.CargaHoraria min</span>
                        <span class="badge bg-light text-dark">@(t.Conteudos?.Count ?? 0) conteúdos</span>
                    </div>

                    <div class="d-flex gap-2 flex-wrap">
                        @* Todos os logados podem abrir a trilha *@
                        <a asp-action="Details" asp-route-id="@t.Id" class="btn btn-dark btn-sm">
                            Abrir
                        </a>

                        @* Só Admin edita e exclui *@
                        @if (isAdmin)
                        {
                            <a asp-action="Edit" asp-route-id="@t.Id"
                               class="btn btn-outline-secondary btn-sm">Editar</a>

                            <form asp-action="Delete" method="post" class="d-inline"
                                  onsubmit="return confirm('Excluir esta trilha e todos os conteúdos?');">
                                <input type="hidden" name="id" value="@t.Id" />
                                <button type="submit" class="btn btn-outline-danger btn-sm">Excluir</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
}
</div>