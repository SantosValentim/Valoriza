@* Lista de programas de mentoria da empresa *@
@model List<Valoriza.API.Models.MentoriaPrograma>
@{
    ViewData["Title"] = "Mentorias";
    var podeGerenciar = (bool)(ViewBag.PodeGerenciar ?? false);
}

@* Aviso (ex.: AdminValoriza sem empresa configurada) *@
@if (ViewBag.Aviso != null)
{
    <div class="alert alert-info">@ViewBag.Aviso</div>
}

@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger">@TempData["Erro"]</div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 mb-0">Programas de Mentoria</h2>

    @* Só AdminValoriza / AdminEmpresa / GestorDEI criam programa *@
    @if (podeGerenciar)
    {
        <a asp-action="Create" class="btn btn-dark btn-sm">Novo programa</a>
    }
</div>

<div class="row g-3">
@if (Model == null || !Model.Any())
{
    <div class="col-12">
        <div class="alert alert-light border">Nenhum programa de mentoria cadastrado.</div>
    </div>
}
else
{
    foreach (var m in Model)
    {
        var qtd = m.Inscricoes?.Count(i => i.Status == "Ativa") ?? 0;
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@m.Titulo</h5>
                    <p class="small text-muted mb-1">
                        Mentor: @(m.Mentor?.NomeCompleto ?? "—")
                    </p>
                    <p class="small text-muted flex-grow-1">
                        @qtd mentorado(s) · <span class="badge bg-secondary">@m.Status</span>
                    </p>
                    <div>
                        <a asp-action="Details" asp-route-id="@m.Id" class="btn btn-dark btn-sm">
                            Abrir
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
}
</div>