@model List<Valoriza.API.Models.Denuncia>
@{
    ViewData["Title"] = "Denúncias";
    var isGestor = (bool)(ViewBag.IsGestorOuAdmin ?? false);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 mb-0">@(isGestor ? "Canal de Denúncias" : "Minhas denúncias")</h2>
    <a asp-action="Create" class="btn btn-dark btn-sm">Nova denúncia</a>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-light border">
        Nenhuma denúncia encontrada.
        <a asp-action="Create">Registrar a primeira</a>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Protocolo</th>
                        <th>Título</th>
                        <th>Status</th>
                        <th>Data</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var d in Model)
                {
                    <tr>
                        <td><code>@d.Protocolo</code></td>
                        <td>
                            @d.Titulo
                            @if (d.Anonima)
                            {
                                <span class="badge bg-secondary">Anônima</span>
                            }
                        </td>
                        <td>@d.Status</td>
                        <td>@d.DataRegistro.ToString("dd/MM/yyyy")</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@d.Id"
                               class="btn btn-sm btn-outline-dark">Acompanhar</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}