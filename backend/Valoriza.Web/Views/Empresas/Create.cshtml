@* Formulário de cadastro de empresa *@
@{
    ViewData["Title"] = "Nova Empresa";
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">&larr; Voltar</a>
</div>

<div class="card p-4 col-md-8">
    <h3 class="h5 mb-3">Cadastrar empresa</h3>

    @if (ViewBag.Erro != null)
    {
        <div class="alert alert-danger">@ViewBag.Erro</div>
    }

    <form method="post" asp-action="Create">
        @* Nenhum input de Id *@
        <div class="mb-3">
            <label class="form-label">Razão social</label>
            <input type="text" name="razaoSocial" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Nome fantasia</label>
            <input type="text" name="nomeFantasia" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">CNPJ</label>
            <input type="text" name="cnpj" class="form-control" required maxlength="18"
                   placeholder="00.000.000/0000-00" />
        </div>

        <div class="mb-3">
            <label class="form-label">Setor / Segmento</label>
            <input type="text" name="segmento" class="form-control"
                   placeholder="Ex.: Tecnologia, Saúde, Varejo" />
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Qtd. colaboradores</label>
                <input type="number" name="quantidadeColaboradores"
                       class="form-control" value="0" min="0" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Plano</label>
                <select name="plano" class="form-select">
                    <option value="Basic">"Básico"</option>
                    <option value="Pro">"Profissional"</option>
                    <option value="Enterprise">"Empresarial"</option>
                </select>
            </div>
        </div>

        <button type="submit" class="btn btn-dark">Salvar</button>
    </form>
</div>