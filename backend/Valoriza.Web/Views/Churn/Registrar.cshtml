@model Valoriza.API.Models.Empresa
@{
    ViewData["Title"] = "Registrar churn";
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">&larr; Voltar</a>
</div>

<div class="card p-4 col-md-7">
    <h3 class="h5 mb-3">Registrar churn</h3>
    <p>
        Empresa: <strong>@(Model.NomeFantasia ?? Model.RazaoSocial)</strong><br />
        <span class="text-muted small">@Model.Cnpj · Plano @Model.Plano · @Model.ValorAssinatura.ToString("C")</span>
    </p>

    <form method="post" asp-action="Registrar">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />

        <div class="mb-3">
            <label class="form-label">Motivo do cancelamento</label>
            <textarea name="motivoChurn" class="form-control" rows="3"
                      placeholder="Ex.: custo, migrou para concorrente, encerrou operação..."></textarea>
        </div>

        <button type="submit" class="btn btn-danger"
                onclick="return confirm('Confirmar churn desta empresa?');">
            Confirmar churn
        </button>
    </form>
</div>